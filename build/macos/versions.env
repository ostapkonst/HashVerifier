# Pinned macOS build inputs. Keep these commits stable so the GTK-OSX and
# bundler toolchains do not change underneath a release build.

GTK_OSX_BUILD_REPO="https://github.com/jralls/gtk-osx-build.git"
GTK_OSX_BUILD_COMMIT="857ad1d7d6fc9b93d630782205f6fb2a74b62dc3"

# GNOME's GitLab repository, mirrored on GitHub. The mirror is used here
# because it is reachable from CI without GitLab API/availability issues.
GTK_MAC_BUNDLER_REPO="https://github.com/GNOME/gtk-mac-bundler.git"
GTK_MAC_BUNDLER_COMMIT="fbc6ffd1590cec6fef6e17ec19b6aa00ce01ca6d"

JHBUILD_COMMIT="16e05af9b58b9e7433ce7417ecd8915beba59133"

PYTHON_VERSION="3.14.4"
MACOS_DEPLOYMENT_TARGET="12.0"
GTK_OSX_MODULES="meta-gtk-osx-gtk3"
